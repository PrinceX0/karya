# .env.example - Example environment variables for Karya sandbox and agent configurations
PORT=4000
CHAOS=

# Primary LLM API configuration (used in later phases)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_primary_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Fallback LLM API configuration
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_API_KEY=your_fallback_api_key_here
FALLBACK_MODEL=llama-3.3-70b-versatile
